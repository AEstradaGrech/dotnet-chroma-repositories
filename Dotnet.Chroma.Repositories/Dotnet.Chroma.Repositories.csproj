<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.112">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
	  <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
	  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
	  <PackageReference Include="Microsoft.SemanticKernel.Connectors.Chroma" Version="1.74.0-alpha" />
  </ItemGroup>

  <PropertyGroup>
	<AssemblyName>Estrada.ChromaDB.Repositories</AssemblyName>
    <PackageId>Estrada.ChromaDB.Repositories</PackageId>
    <Version>0.1.3-alpha</Version>
    <Title>Dotnet Chroma Repositories</Title>
    <Authors>Alvaro Estrada</Authors>
    <Description>Lightweight ChromaDB repository SDK for .NET</Description>
	<PackageTags>chroma vectordb rag ai llm semantic-search</PackageTags>
    <PackageProjectUrl>https://github.com/AEstradaGrech/dotnet-chroma-repositories</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AEstradaGrech/dotnet-chroma-repositories</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>
</Project>
